#!/usr/bin/expect -f

# Opt-in live PTY proof. The caller provides a disposable project and checks
# its settings after each mode. Normal Claude authentication is reused, while
# --setting-sources project prevents user settings from participating.
set timeout 15
if {$argc != 4} {
  puts stderr "usage: expect tests/config-picker.exp select|persist CLAUDE PLUGIN DISPOSABLE_PROJECT"
  exit 2
}

set mode [lindex $argv 0]
set claude [file normalize [lindex $argv 1]]
set plugin [file normalize [lindex $argv 2]]
set project [file normalize [lindex $argv 3]]
if {$mode ni {select persist}} {
  puts stderr "unsupported picker mode: $mode"
  exit 2
}
if {![file executable $claude] || ![file isdirectory $plugin] || ![file isdirectory $project]} {
  puts stderr "Claude, plugin, and disposable project paths must already exist"
  exit 2
}
set temp_root [file normalize $env(TMPDIR)]
if {![string match "$temp_root/*" $project]} {
  puts stderr "refusing to run /config outside the OS temporary directory: $project"
  exit 2
}

unset -nocomplain env(CLAUDE_CONFIG_DIR)
unset -nocomplain env(CLAUDE_CODE_PLUGIN_CACHE_DIR)
set env(TERM) xterm-256color
set env(COLUMNS) 80
set env(LINES) 24
set transcript [file join $project ".config-picker-$mode.log"]
set local_settings [file join $project ".claude" "settings.local.json"]

# Rendering alone does not prove the picker did anything: a run whose keys
# arrive while the list is still loading draws the right screen and changes
# nothing. Each mode therefore states what the project-local setting must
# look like before it starts and after it finishes.
proc selected {} {
  global local_settings
  if {![file exists $local_settings]} {
    return 0
  }
  set channel [open $local_settings r]
  set data [read $channel]
  close $channel
  return [regexp {"outputStyle"\s*:\s*"korean-plain:Korean Plain"} $data]
}

# The transcript holds raw output of an authenticated session. Create it with
# restricted permissions before anything is written, and remove it on every
# exit path.
proc fail {message} {
  global transcript
  log_file
  file delete -force $transcript
  puts stderr $message
  exit 1
}

if {$mode eq "select" && [selected]} {
  puts stderr "select must start from a project that has not selected Korean Plain"
  exit 2
}
if {$mode eq "persist" && ![selected]} {
  puts stderr "persist must start from a project that already selected Korean Plain"
  exit 2
}

close [open $transcript w]
file attributes $transcript -permissions 0600
cd $project
log_user 1
log_file -noappend $transcript
spawn -noecho $claude --plugin-dir $plugin --setting-sources project,local

expect {
  -nocase -re {quick.*safety.*check} {
    expect -nocase -re {enter.*confirm}
    send -- "\r"
    exp_continue
  }
  -re {Try.*"} {}
  timeout {
    fail "Claude did not reach its interactive prompt"
  }
  eof {
    fail "Claude exited before /config opened"
  }
}

send -- "/config\r"
expect {
  -re {Search.*settings} {}
  timeout {
    fail "/config did not open the settings search"
  }
}
send -- "output style"
expect {
  -nocase -re {Output.*style} {}
  timeout {
    fail "Output style search did not find the picker row"
  }
}
if {$mode eq "persist"} {
  expect {
    -re {korean-plain.*Korean.*Plain} {}
    timeout {
      fail "Fresh process did not render the persisted Korean Plain setting"
    }
  }
} else {
  send -- "\033\[B"
  after 250
  send -- "\r"
  expect {
    -re {korean-plain.*Korean.*Plain} {}
    timeout {
      fail "Output style picker did not render Korean Plain"
    }
  }
}

if {$mode eq "select"} {
  for {set index 0} {$index < 4} {incr index} {
    send -- "\033\[B"
    expect {
      -re {❯} {}
      timeout {
        fail "Output style cursor did not move down"
      }
    }
  }
  send -- "\r"
  after 900
} else {
  # The fresh process rendered the project-local selection above.
  after 500
}

send -- "\033\033\033"
after 500
if {$mode eq "persist"} {
  send -- "/clear\r"
  expect {
    -re {Try.*"} {}
    timeout { after 700 }
  }
}
send -- "/exit\r"
expect {
  eof {}
  timeout {
    send -- "\003"
    after 250
    send -- "\003"
    expect {
      eof {}
      timeout {
        fail "Claude did not exit after /exit and Ctrl-C fallback"
      }
    }
  }
}
log_file

set channel [open $transcript r]
set output [read $channel]
close $channel
if {[string first "korean-plain" $output] < 0 || [string first "Korean" $output] < 0 || [string first "Plain" $output] < 0} {
  fail "$mode did not visibly render the Korean Plain output style"
}
if {![selected]} {
  fail "$mode rendered the picker but left Korean Plain unselected in $local_settings"
}
file delete -force $transcript
puts "CONFIG_PICKER_[string toupper $mode]_OK"
